# Copia este archivo a .env (install.sh lo hace por ti). NUNCA subas .env a GitHub.

SHOP_DOMAIN=shop.civired.com
SHOP_PORT=3020

# Base de datos (install.sh genera contraseñas aleatorias)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Acceso de la sincronización a WooCommerce (install.sh lo crea con una "contraseña de aplicación")
WP_USER=
WP_APP_PASSWORD=

# ---- Precios ----
# Margen sobre el precio de coste del proveedor (sin IVA). El precio publicado ya lleva el IVA.
MARGIN_PCT=0
# Margen mínimo en euros por producto (cubre comisión del pago). 0 = sin mínimo.
MIN_MARGIN_EUR=0
# Redondeo: none | 99 (ej. 123,99 €)
PRICE_ROUNDING=none
VAT_PCT=21

# ---- Catálogo ----
# Cuántas horas entre sincronizaciones completas de precio/stock
SYNC_HOURS=4
# Límite de productos (empieza bajo para probar; súbelo cuando todo vaya bien)
MAX_PRODUCTS=200
# Qué se vende: se define en sync/catalog.json (en GitHub). Estas variables, si se rellenan, lo sustituyen.
# Categorías de Ingram separadas por "|". Ej: Displays|Notebooks|Printers
IM_CATEGORIES=
# Marcas separadas por "|". Ej: HP|LENOVO
IM_VENDORS=
# Palabras clave separadas por "|"
IM_KEYWORDS=
# Solo publicar productos con foto (1 = sí)
REQUIRE_IMAGE=1
# Solo publicar productos con stock en al menos un proveedor (1 = sí)
REQUIRE_STOCK=1

# ---- Ingram Micro (Xvantage) ----
IM_CLIENT_ID=
IM_CLIENT_SECRET=
IM_CUSTOMER_NUMBER=
IM_COUNTRY=ES
IM_SENDER_ID=CiviRedShop
IM_BASE=https://api.ingrammicro.com:443

# ---- Icecat (fotos y fichas) ----
# Usuario de Open Icecat (gratis en icecat.biz). Las fotos se copian a la tienda una sola vez.
ICECAT_USER=civired
ICECAT_LANG=es

# ---- Pedidos ----
# off = no hace nada | notify = deja nota en el pedido y avisa | auto = crea el pedido en el proveedor
ORDERS_MODE=notify
# Avisos por Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
